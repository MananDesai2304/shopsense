# Postgres for local dev (compose.yaml, service "db"). Copy to .env and change the password.
POSTGRES_USER=shopsense
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopsense
# Host port the db container is published on. compose.yaml falls back to 5434 if unset.
POSTGRES_PORT=5434
# Used by Alembic and the app. User, password, db, and port must match the values above.
DATABASE_URL=postgresql+psycopg://shopsense:change-me@localhost:5434/shopsense

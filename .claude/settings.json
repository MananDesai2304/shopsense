{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run --package api pytest)",
      "Bash(uv run --package api pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Bash(* .env)",
      "Bash(* .env.local)",
      "Bash(* .env.production)"
    ]
  }
}